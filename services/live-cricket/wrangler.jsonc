{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playoff-pulse-live-cricket",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "durable_objects": {
    "bindings": [{ "name": "COLLECTOR", "class_name": "CricketCollector" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CricketCollector"] }],
  "vars": {
    "SCORE_PROVIDER": "sportscore",
    "SPORTSCORE_DAILY_CREDITS": "9000",
    "CRICDATA_ACCESS_ENABLED": "false",
    "CRICDATA_REDISPLAY_ALLOWED": "false",
    "CRICDATA_FANTASY_ENABLED": "false",
    "SPORTMONKS_ACCESS_ENABLED": "false",
    "SPORTMONKS_REDISPLAY_ALLOWED": "false",
    "ODDS_ACCESS_ENABLED": "false",
    "ODDS_REDISPLAY_ALLOWED": "false",
    "CRICDATA_DAILY_CREDITS": "90",
    "SPORTMONKS_DAILY_CREDITS": "90",
    "ODDS_MONTHLY_CREDITS": "450",
    "ODDS_REGIONS": "uk",
    "ODDS_SCOPES_JSON": "[]",
    "DISCOVERY_SECONDS": "60",
    "DETAIL_SECONDS": "60",
    "MARKET_SECONDS": "14400",
    "STALE_SECONDS": "180",
    "MAX_DISCOVERY_PAGES": "2",
    "ALLOWED_ORIGINS": "https://ipl-playoff-pulse.pages.dev,https://rakeshnreddy.github.io,http://localhost:5173,http://127.0.0.1:5173",
  },
}
