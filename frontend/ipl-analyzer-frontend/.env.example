# Optional: the deployed normalized Live Cricket service origin (public, never an API key).
# Leave empty to use SportScore's free keyless public cricket source directly.
VITE_LIVE_CRICKET_API_URL=

# Public contact address shown on static trust/advertising pages. No private address is assumed.
VITE_PUBLIC_CONTACT_EMAIL=

# Optional PUBLIC AdSense identifier only, supplied by the account owner.
# Blank emits no verification metadata or ads.txt; no advertising script is loaded.
VITE_ADSENSE_PUBLISHER_ID=
# Readiness assertions do not provision an account, consent service, or ad serving.
# Set these only after the corresponding real account/site/CMP reviews have completed.
VITE_ADS_ENABLED=false
VITE_ADSENSE_SITE_APPROVED=false
VITE_ADSENSE_CMP_READY=false

# Optional real sponsor details; no campaign or paid link is invented when blank.
# The commercial eligibility helper allows only the reviewed primary cricket source.
VITE_SPONSOR_NAME=
VITE_SPONSOR_URL=
VITE_SPONSOR_MESSAGE=
